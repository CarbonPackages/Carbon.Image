prototype(Carbon.Image:Component.Fragment.Figcaption) < prototype(Neos.Fusion:Component) {
    figureTagName = 'figure'
    content = ${null}
    figcaptionClass = ${null}
    lightboxCaption = ${null}
    figcaptionMarkup = ${null}

    lightboxCaptionClass = 'pswp-caption-content'

    @private.hasContentAndFigureAsParent = ${(props.content || props.lightboxCaption) && props.figureTagName == 'figure'}

    renderer = afx`
        {props.figcaptionMarkup}
        <figcaption
            @if={private.hasContentAndFigureAsParent && !props.figcaptionMarkup}
            class={props.content ? props.figcaptionClass : props.lightboxCaptionClass}
        >
            {props.content ? props.content : props.lightboxCaption}
            <span
                @if={props.content && props.lightboxCaption}
                class={props.lightboxCaptionClass}
            >
                {props.lightboxCaption}
            </span>
        </figcaption>
    `
}
